# fake tools first on PATH shadow any real ones
chmod 755 bin/restic
chmod 755 bin/rsync
env PATH=$WORK/bin:$PATH

exec milbi doctor
stdout 'restic 0.17.0 fake'
stdout 'rsync  version 3.3.0 fake'
! stdout warning

-- bin/restic --
#!/bin/sh
# like the real restic: only the `version` subcommand exists, `--version` is an error
[ "$1" = version ] || { echo "unknown flag: $1" >&2; exit 1; }
echo "restic 0.17.0 fake"
-- bin/rsync --
#!/bin/sh
[ "$1" = --version ] || exit 1
echo "rsync  version 3.3.0 fake"
