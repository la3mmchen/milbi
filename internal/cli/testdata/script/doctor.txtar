# fake tools first on PATH shadow any real ones
chmod 755 bin/restic
chmod 755 bin/rsync
env PATH=$WORK/bin:$PATH

exec milbi doctor
stdout 'restic 0.17.0 fake'
stdout 'rsync  version 3.3.0 fake'
! stdout warning

-- bin/restic --
#!/bin/sh
echo "restic 0.17.0 fake"
-- bin/rsync --
#!/bin/sh
echo "rsync  version 3.3.0 fake"
